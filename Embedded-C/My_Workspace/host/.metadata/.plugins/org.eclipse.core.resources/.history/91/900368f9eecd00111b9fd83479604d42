void quad(int a, int b, int c){

	float D, d;
	float x1;
	float x2;
	D = (b*b) - 4*a*c;

	if (D < 1){
		negative_complex(D, a, b);
	exit(0);
	}

	d = sqrt(D);

	x1 = (-b + d) / (2*a);
	x2 = (-b - d) / (2*a);

	printf("The roots of the equation is %.2f & %.2f and D is %.2f", x1, x2, D);
}

void negative_complex(float negative, int a, int b){

	float complex negroot = csqrt(negative);
	float complex x1, x2;

	x1 = (-b + negroot) / (2*a);
	x2 = (-b - negroot) / (2*a);

	printf("The discriminant is negative -> %.1f and the root is: %.5f + %.5fi\n", negative, creal(x1), cimag(x1));
	printf("The discriminant is negative -> %.1f and the root is: %.5f -  %.5fi", negative, creal(x2), cimag(x2)*-1);

}
